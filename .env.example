# ---------------------------------------------------------------------------
# supplement-keyword-scout environment configuration
# Copy this file to `.env` and fill in the values you have. Every key is
# optional; the tool degrades gracefully and logs which mode it is running in.
# ---------------------------------------------------------------------------

# Preferred data source. Get a key at https://serpapi.com/
# When set, Google + Amazon results are pulled via SerpApi.
# When empty, the tool falls back to Playwright scraping and logs FALLBACK mode.
SERPAPI_KEY=

# Optional: Google locale/geo tuning for SerpApi and the scraper.
SERP_LOCATION=United States
SERP_GL=us
SERP_HL=en

# Optional: throttle between requests (milliseconds). A random jitter is added.
REQUEST_DELAY_MS=2500

# Optional Notion sync (only used with the --sync-notion flag).
# Create an internal integration at https://www.notion.so/my-integrations
NOTION_API_KEY=
NOTION_DATABASE_ID=
